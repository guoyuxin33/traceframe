{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traceframe",
  "version": "0.1.0",
  "identifier": "dev.traceframe.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Traceframe",
        "width": 1600,
        "height": 1000,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Transparent multi-agent coding workspace",
    "longDescription": "Traceframe makes agent execution, code changes, branches, context and memory visible in one desktop workspace.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
